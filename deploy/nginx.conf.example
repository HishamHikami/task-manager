# /etc/nginx/sites-available/taskmanager  (replace tasks.example.com)
# Start with this HTTP-only block, then run:
#   certbot --nginx -d tasks.example.com
# certbot adds the HTTPS server block and the redirect.

server {
    listen 80;
    listen [::]:80;
    server_name tasks.example.com;

    client_max_body_size 10m;

    location /static/ {
        alias /srv/taskmanager/staticfiles/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://unix:/run/taskmanager/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 70s;
    }
}
