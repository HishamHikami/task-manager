# Copy to .env (development) or /etc/taskmanager/env (production).
# Plain KEY=value lines, no quotes or spaces (read by both systemd and the shell).

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Never 1 in production.
DEBUG=0

# Your domain(s), comma-separated.
ALLOWED_HOSTS=tasks.example.com
CSRF_TRUSTED_ORIGINS=https://tasks.example.com

# Your local time zone, e.g. Asia/Dubai, Asia/Riyadh, Europe/London.
TIME_ZONE=UTC

# Where the SQLite database and backups live.
DATA_DIR=/var/lib/taskmanager

# Where collectstatic puts CSS/JS for nginx to serve.
STATIC_ROOT=/srv/taskmanager/staticfiles

# Optional: separate secret used to encrypt the AI API key stored in the database.
# If empty, one is derived from SECRET_KEY.
FIELD_ENCRYPTION_KEY=
